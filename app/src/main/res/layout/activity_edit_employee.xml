<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FAF7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←  Kembali"
            android:textColor="#31A968"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Detail Pegawai"
            android:textColor="#24553A"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="25dp"
            android:text="Periksa dan ubah informasi pegawai."
            android:textColor="#89968E"
            android:textSize="13sp"/>

        <!-- FULL NAME -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Lengkap"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Nama lengkap"
            android:textSize="14sp"
            android:singleLine="true"/>

        <!-- EMPLOYEE NUMBER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nomor Pegawai / NIP"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etEmployeeNumber"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Nomor pegawai"
            android:textSize="14sp"
            android:singleLine="true"/>

        <!-- DEPARTMENT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Departemen"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etDepartment"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Departemen"
            android:textSize="14sp"
            android:singleLine="true"/>

        <!-- POSITION -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Jabatan"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etPosition"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Jabatan"
            android:textSize="14sp"
            android:singleLine="true"/>

        <!-- PHONE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nomor Telepon"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Nomor telepon"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="phone"/>

        <!-- EMAIL INFO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Informasi"
            android:textColor="#24553A"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Alamat email dan password akun tidak diubah melalui halaman ini."
            android:textColor="#89968E"
            android:textSize="12sp"/>

        <!-- SAVE BUTTON -->

        <TextView
            android:id="@+id/btnSaveEmployee"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="25dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="Simpan Perubahan"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</ScrollView>
