<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FAF7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←  Kembali"
            android:textColor="#31A968"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Tambah Pegawai"
            android:textColor="#24553A"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="25dp"
            android:text="Masukkan informasi pegawai yang akan didaftarkan."
            android:textColor="#89968E"
            android:textSize="13sp"/>

        <!-- FULL NAME -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Lengkap *"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Masukkan nama lengkap"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="textCapWords"/>

        <!-- EMPLOYEE NUMBER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nomor Pegawai / NIP *"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etEmployeeNumber"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Contoh: EMP002"
            android:textSize="14sp"
            android:singleLine="true"/>

        <!-- EMAIL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Email Pegawai *"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Masukkan email aktif"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="textEmailAddress"/>

        <!-- PASSWORD -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Password Sementara *"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Minimal 8 karakter"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="textPassword"/>

        <!-- DEPARTMENT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Departemen"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etDepartment"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Contoh: IT"
            android:textSize="14sp"
            android:singleLine="true"/>

        <!-- POSITION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Jabatan"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etPosition"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Contoh: Staff"
            android:textSize="14sp"
            android:singleLine="true"/>

        <!-- PHONE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nomor Telepon"
            android:textColor="#344A3B"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="08xxxxxxxxxx"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="phone"/>

        <!-- SAVE BUTTON -->
        <TextView
            android:id="@+id/btnSaveEmployee"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="25dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="Simpan Pegawai"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</ScrollView>
