<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FAF7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="←  Kembali"
                android:textColor="#31A968"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_status_success"
                android:gravity="center"
                android:paddingHorizontal="13dp"
                android:text="↻ Refresh"
                android:textColor="#31A968"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Data Kehadiran"
            android:textColor="#24553A"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pantau aktivitas kehadiran seluruh pegawai."
            android:textColor="#89968E"
            android:textSize="13sp"/>

        <!-- DATE FILTER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Pilih Tanggal"
            android:textColor="#344A3B"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp"
            android:text="Pilih tanggal"
            android:textColor="#24553A"
            android:textSize="14sp"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:drawableTint="#31A968"
            android:clickable="true"
            android:focusable="true"/>

        <!-- STATISTICS TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Ringkasan Kehadiran"
            android:textColor="#24553A"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <!-- STATISTICS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="103dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_card"
                android:padding="13dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Hadir"
                    android:textColor="#89968E"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvTotalRecords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="0"
                    android:textColor="#24553A"
                    android:textSize="27sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="103dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_card"
                android:padding="13dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hadir"
                    android:textColor="#89968E"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvPresentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="0"
                    android:textColor="#31A968"
                    android:textSize="27sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="103dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_card"
                android:padding="13dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terlambat"
                    android:textColor="#89968E"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvLateCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="0"
                    android:textColor="#D99B29"
                    android:textSize="27sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- SEARCH -->

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="23dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="15dp"
            android:hint="Cari nama, NIP, atau departemen..."
            android:textColor="#24553A"
            android:textColorHint="#A2AEA6"
            android:textSize="13sp"
            android:singleLine="true"/>

        <!-- LIST TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Daftar Kehadiran"
            android:textColor="#24553A"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <!-- LOADING -->

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginTop="25dp"
            android:indeterminateTint="#31A968"
            android:visibility="gone"/>

        <!-- ERROR -->

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="#D34B4B"
            android:textSize="13sp"
            android:visibility="gone"/>

        <!-- EMPTY -->

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:padding="25dp"
            android:text="Belum ada data kehadiran."
            android:textColor="#89968E"
            android:textSize="13sp"
            android:visibility="gone"/>

        <!-- DYNAMIC LIST -->

        <LinearLayout
            android:id="@+id/attendanceContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="vertical"/>

        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="Absensi Apps © 2026"
            android:textColor="#AAB6AE"
            android:textSize="11sp"/>

    </LinearLayout>

</ScrollView>
